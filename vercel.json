{
  "builds": [
    { "src": "server.php", "use": "vercel-php@0.9.0" },
    { "src": "favicon.png", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "admin/assets/**", "use": "@vercel/static" },
    { "src": "staff/assets/**", "use": "@vercel/static" },
    { "src": "student/assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*\\.(css|js|eot|gif|jpg|jpeg|png|svg|ttf|woff|woff2|otf|ico))$", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/server.php" }
  ]
}
